  "declarations": "typedef struct {\n    u8 pad00[0x4C];\n    f32 scale;\n    u8 pad50[0x34];\n    u16 kind;\n} Effect151C7038;\ntypedef struct {\n    u8 pad00[0x60];\n    u32 flags;\n    u8 pad64[0x0C];\n    u8 intensity;\n    u8 pad71[0x0B];\n    Effect151C7038 *effect;\n} Owner151C7038;\ns32 func_15142A5C(s32 *effect);\n",
  "comment": "/* Update effect status and scaled intensity for effect type 0xE9. */",
  "body": "s32 func_151C7038(Owner151C7038 *owner) {\n    Effect151C7038 *effect = owner->effect;\n    f32 intensity;\n\n    if (effect->kind != 0xE9) {\n        return 0;\n    }\n    if (func_15142A5C((s32 *)effect) != 0) {\n        owner->flags |= 0x20000;\n    } else {\n        owner->flags &= ~0x20000;\n    }\n    intensity = effect->scale * 35.0f;\n    if (intensity > 255.0f) {\n        intensity = 255.0f;\n    } else if (intensity < 0.0f) {\n        intensity = 0.0f;\n    }\n    owner->intensity = (u32)intensity;\n    return 1;\n}",
