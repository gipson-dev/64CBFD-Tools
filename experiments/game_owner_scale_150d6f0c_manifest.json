  "declarations": "extern f32 D_800BE9A4;\nf32 sqrtf(f32);\ntypedef struct {\n    u8 *target;\n    u8 identity;\n    u8 pad05[3];\n    f32 elapsed;\n    f32 limit;\n    f32 scale;\n    f32 alpha;\n    f32 decay;\n} Motion150D6F0C;\n",
  "comment": "/* Update the linked owner's position, scale, alpha and elapsed time. */",
  "body": "s32 func_150D6F0C(u8 *owner, void *context) {\n    Motion150D6F0C *link = (Motion150D6F0C *)(owner + 0xA8);\n    u8 *target = link->target;\n    f32 size;\n    f32 time;\n\n    if (*(s32 *)target == 0 || link->identity != target[0x3B]) {\n        return 0;\n    }\n    func_150D6C98((f32 *)target, (f32 *)(owner + 0x40));\n    size = sqrtf(link->elapsed) * link->scale;\n    *(f32 *)(owner + 0x3C) = size;\n    *(f32 *)(owner + 0x38) = size;\n    time = link->elapsed;\n    owner[0x2B] = (u32)(link->alpha - (link->decay * time * time));\n    link->elapsed += D_800BE9A4;\n    if (link->limit < link->elapsed) {\n        return 0;\n    }\n    return 1;\n}",
