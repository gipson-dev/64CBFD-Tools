    "game_C8950": {
      "path": "conker/src/game_C8950.c",
      "before_sha256": "85b7d65d351e1c598b633fe633413ed5e310a2b2df8cafd19be2ded9e51fb401",
      "after_sha256": "b72db30ce856086099b9697a04a3c38113369886534da84dd88c85dbdb40d48e",
      "changes": [
        {
          "old_at": 1,
          "new_at": 1,
          "old": "",
          "new": "#include <stdarg.h>\n"
        },
        {
          "old_at": 28,
          "new_at": 29,
          "old": "s32 func_1509BE40();\n",
          "new": "s32 func_1509BE40(s32, ...);\n"
        },
        {
          "old_at": 215,
          "new_at": 216,
          "old": "/* Non-matching C placeholders for asm/nonmatchings/game_C8950/func_1509BE40.s. */\ns32 func_1509BE40() {\n    return 0;\n",
          "new": "/* Build the variable-argument script query and dispatch its selected provider. */\nextern s32 D_800D3840;\nextern s32 D_800D2F60[];\nextern s32 (*D_80088498[])(s32, s32, s32 *);\ns32 func_1509BE40(s32 count, ...) {\n    va_list args;\n    s32 key, selector, type, previous, result, i;\n    register s32 flags;\n    va_start(args, count);\n    flags = va_arg(args, s32);\n    key = va_arg(args, s32);\n    previous = D_800D3840;\n    type = ((flags & 0xf000) >> 12) - 1;\n    flags &= 0xfff;\n    selector = flags;\n    D_800D2F60[0] = selector;\n    D_800D2F60[1] = key;\n    for (i = 0; i < count; i++) D_800D2F60[i + 2] = va_arg(args, s32);\n    D_800D3840 = count + 2;\n    result = D_80088498[type](selector, key, D_800D2F60);\n    D_800D3840 = previous;\n    va_end(args);\n    return result;\n"
        }
      ]
    },
    "game/generated_EBD00": {
      "path": "conker/src/game/generated_EBD00.c",
      "before_sha256": "87925081c5f25def600e126b6df05d5ece1bf6b76608a9188616094aa898263c",
      "after_sha256": "8d642bfd9a37edb30b057f11df0f28869eb3f85afacb43a870317198e7e7417c",
      "changes": [
        {
          "old_at": 2,
          "new_at": 2,
          "old": "/* Non-matching placeholders for the text-only asm slice asm/EBD00.s. */\n",
          "new": "/* Camera-condition callback for the script-selected view. */\n"
        },
        {
          "old_at": 4,
          "new_at": 4,
          "old": "s32 func_150BE850() {\n    return 0;\n",
          "new": "#include \"structs.h\"\nextern f32 D_800A00B0, D_800A00B4;\nextern u8 D_800CC335;\ns32 func_1509BE40(s32, ...);\nvoid func_1509BFB0(s32, s32, s32, ...);\nvoid func_1512868C(struct108 *);\ns32 func_15123934(struct108 *, s32, s32, s32, s32);\nvoid func_151254F4(struct108 *, s32);\nvoid func_15123070(struct108 *);\ns32 func_151239CC(struct108 *, s32);\n\n/* Update camera state from the current script conditions. */\nvoid func_150BE850(s32 cameraAddress) {\n    s32 value;\n    s32 condition;\n    f32 width;\n    f32 height;\n    condition = func_1509BE40(0, 0x2006, 0xB7);\n    condition = func_1509BE40(0, condition | 0x2000, 0xBC);\n    value = func_1509BE40(0, 0x2000, 0xBB);\n    if (condition != 0 && value != -1) {\n        func_1509BFB0(0, 0x400E, 1);\n        if (*(s32 *)((u8 *)(struct108 *)cameraAddress + 0x2C) != 8) {\n            func_1512868C((struct108 *)cameraAddress);\n        }\n        if (func_15123934((struct108 *)cameraAddress, 8, 0, *(s32 *)((u8 *)(struct108 *)cameraAddress + 0x134), 3)) {\n            func_151254F4((struct108 *)cameraAddress, D_800CC335 - 1);\n            *(u32 *)((u8 *)(struct108 *)cameraAddress + 0x84) |= 0x1000200;\n            *(s16 *)((u8 *)(struct108 *)cameraAddress + 0x73C) = 0;\n            *(u32 *)((u8 *)(struct108 *)cameraAddress + 0x84) &= ~4;\n            *(f32 *)((u8 *)(struct108 *)cameraAddress + 0x674) = 0.0f;\n        }\n        width = D_800A00B0;\n        height = D_800A00B4;\n        *(f32 *)((u8 *)(struct108 *)cameraAddress + 0x348) = width;\n        *(f32 *)((u8 *)(struct108 *)cameraAddress + 0x34C) = width;\n        *(f32 *)((u8 *)(struct108 *)cameraAddress + 0x374) = height;\n        *(f32 *)((u8 *)(struct108 *)cameraAddress + 0x190) = 0.0f;\n        func_15123070((struct108 *)cameraAddress);\n    } else if (func_151239CC((struct108 *)cameraAddress, 3)) {\n        func_151254F4((struct108 *)cameraAddress, 0);\n        *(f32 *)((u8 *)(struct108 *)cameraAddress + 0x674) = 0.0f;\n        func_1509BFB0(0, 0x400E, 0);\n    }\n"
        }
      ]
    },
