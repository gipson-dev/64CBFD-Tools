  "selected": "extern f32 D_800990A0, D_800990A4, D_800990A8;\nextern f32 fabsf(f32);\n#pragma intrinsic (fabsf)\n\n/* Evaluate the retail exponential approximation with a convergent series. */\nf32 func_1504A2B0(f32 x) {\n    f32 magnitude = fabsf(x);\n    f32 result;\n    f32 term;\n    f32 previous;\n    f32 remainder;\n    s32 scale;\n    s32 index;\n    s32 remaining;\n\n    if (magnitude < 1.1920929e-7f) {\n        return 1.0f;\n    }\n    scale = (s32)(magnitude / D_800990A0);\n    remaining = scale;\n    if (scale >= 1025) {\n        if (x >= 0.0f) {\n            return D_800990A4;\n        }\n        return 0.0f;\n    }\n    result = 1.0f;\n    term = 1.0f;\n    index = 1;\n    remainder = magnitude - (f32)scale * D_800990A8;\n    do {\n        previous = result;\n        term *= remainder / (f32)index;\n        result += term;\n        index++;\n    } while (result != previous);\n    while (remaining != 0) {\n        result += result;\n        remaining--;\n    }\n    if (x >= 0.0f) {\n        return result;\n    }\n    return 1.0f / result;\n}\n",
