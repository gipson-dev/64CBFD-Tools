static void quit(int status){__asm__ volatile("int $0x80"::"a"(1),"b"(status):"memory");__builtin_unreachable();}
static void fail(const char*s){u32 n=0;while(s[n])n++;__asm__ volatile("int $0x80"::"a"(4),"b"(2),"c"(s),"d"(n):"memory");quit(3);}
void *memcpy(void*d,const void*s,u32 n){u8*a=d;const u8*b=s;for(u32 i=0;i<n;i++)a[i]=b[i];return d;}
static u32 fbits(f32 f){union{f32 f;u32 u;}v;v.f=f;return v.u;}
static void word(u32 v){trace=(trace^v)*16777619u;}
static void log_call(u32 t,const u32*a,u32 n,int vectors){
 word(t);word(n);for(u32 i=0;i<n;i++)word(a[i]);word(vectors?48:0);
 if(vectors)for(u32 k=0;k<4;k++){const u8*b=(const u8*)retained[k];for(u32 i=0;i<12;i++)word(b[4*(i/4)+3-i%4]);}
 *(u32 *)MARK=0x13579BDFu+ordinal*0x10203u+t;
}
static void effects(void){
 if(mutation&1){MenuBurstPointE4070*c=(void*)argv[0];c->x=(ordinal%17)*.125f;c->y=(ordinal%17)*.125f+1;c->z=(ordinal%17)*.125f+2;*(f32*)argv[2]=(ordinal%7)*.25f+.5f;*(f32*)argv[3]=(ordinal%5)*.125f+.25f;}
 if(mutation&2)for(u32 i=0;i<4;i++)if(retained[i]){retained[i]->x=(ordinal%19)*.125f+i;retained[i]->y=(ordinal%19)*.125f+i+.25f;retained[i]->z=(ordinal%19)*.125f+i+.5f;}
}
s32 func_150ADA20(void){log_call(RNG,0,0,0);effects();u32 answer=integers?seed*0x9E3779B9u+integers*0x13579BDFu:initial_value;integers++;ordinal++;return(s32)answer;}
f32 func_150ADA68(void){log_call(REAL,0,0,0);effects();f32 answer=((seed+reals*7)%17)/16.f;reals++;ordinal++;return answer;}
void func_15143794(s16 h,s16 p,f32 magnitude,MenuBurstPointE4070*v){
 u32 index=(directions&1)?2:0;if(retained[index]&&retained[index]!=v)fail("direction address");retained[index]=v;
 u32 a[]={(u32)(s32)h,(u32)(s32)p,fbits(magnitude),0xFFFFFF00u+index};log_call(DIRECTION,a,4,0);effects();
 u32 q=((h&255)+(p&255)+((fbits(magnitude)>>16)&255))&511;v->x=q/128.f;v->y=(q+17)/128.f;v->z=(q+34)/128.f;directions++;ordinal++;
}
void *func_1518A3C0(MenuBurstPointE4070*p,MenuBurstPointE4070*r,f32 size,MenuBurstPointE4070*v,MenuBurstPointE4070*a,f32 rate,f32 factor,u8 kind,s16 life,u8 flag,s32 value,u8 alpha,s32 context){
 if(retained[0]!=p||retained[2]!=v)fail("submit address");retained[1]=r;retained[3]=a;
 u32 args[]={0xFFFFFF00u,0xFFFFFF01u,fbits(size),0xFFFFFF02u,0xFFFFFF03u,fbits(rate),fbits(factor),kind,(u32)(s32)life,flag,(u32)value,alpha,(u32)context};
 log_call(SUBMIT,args,13,1);effects();submits++;*(u32*)OUTPUT=0x98760000u+submits;ordinal++;return success?(void*)OUTPUT:0;
