 mapping(INPUT,4096);mapping(OUTPUT,4096);mapping(MARK,4096);file=fixture_rows;
 if(sizeof(void*)!=4||sizeof(MenuBurstPointE4070)!=12)fail("layout");u32 cases=get32(),segments=get32();if(segments!=3)fail("segments");
 for(u32 k=0;k<cases;k++){
  seed=get32();initial_value=get32();mutation=get32();success=get32();for(u32 i=0;i<6;i++)argv[i]=get32();u32 wanted_trace=get32(),wanted_submits=get32(),addresses[3],lengths[3];
  for(u32 s=0;s<3;s++){u32 a=addresses[s]=get32(),n=lengths[s]=get32();if(n>0x120)fail("length");exact_read(initial,n);exact_read(expected[s],n);memcpy((void*)a,initial,n);}
  trace=2166136261u;ordinal=integers=reals=directions=submits=0;for(u32 i=0;i<4;i++)retained[i]=0;
  func_150B82D0((void*)argv[0],(void*)argv[1],(void*)argv[2],(void*)argv[3],argv[4],argv[5]);
  if(trace!=wanted_trace)fail("trace");if(submits!=wanted_submits||integers!=1+3*submits||reals!=8*submits||directions!=2*submits)fail("counts");
  for(u32 s=0;s<3;s++)for(u32 i=0;i<lengths[s];i++)if(((u8*)addresses[s])[i]!=expected[s][i])fail("memory");
 }
 if(file!=fixture_end)fail("fixture tail");return 0;
}
__attribute__((force_align_arg_pointer))void _start(void){quit(run());}
