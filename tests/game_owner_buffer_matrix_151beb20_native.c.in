            for (u32 scaleIndex = 0; scaleIndex < 6; scaleIndex++) {
                for (mutation = 0; mutation < 8; mutation++) {
                    for (u32 i = 0; i < sizeof(actor); i++) ((u8 *)&actor)[i] = (u8)(i * 13 + pattern);
                    fill_matrix(actor.matrices[0]);
                    fill_matrix(actor.matrices[1]);
                    actor.x = 1.25f; actor.y = -2.5f; actor.z = 3.75f; actor.angle = .75f;
                    for (u32 i = 0; i < sizeof(actor); i++) ((u8 *)&expected)[i] = ((u8 *)&actor)[i];
                    D_800BE9C0 = (u8)initialPage;
                    initialScale = D_800AA8E0 = scales[scaleIndex];
                    calls = error = 0;
                    fill_matrix(expected.matrices[initialPage]);
                    u32 destination = initialPage ^ (mutation & 1);
                    f32 scale = mutation & 2 ? -.25f : initialScale;
                    if (mutation & 4) {
                        expected.x = -7.5f; expected.y = 8.25f; expected.z = -9.0f; expected.angle = 12.0f;
                    }
                    expected.matrices[destination][3][0] = expected.x;
                    expected.matrices[destination][3][1] = expected.y;
                    expected.matrices[destination][3][2] = expected.z;
                    for (u32 row = 0; row < 3; row++) {
                        for (u32 column = 0; column < 3; column++) expected.matrices[destination][row][column] *= scale;
                    }
                    if (subject(&actor) != 1 || calls != 1 || error) return 1;
                    if (!equal(&actor, &expected, sizeof(actor))) return 1;
                    if (D_800BE9C0 != destination || !equal(&D_800AA8E0, &scale, sizeof(scale))) return 1;
                }
            }
        }
    }
    return 0;
}

