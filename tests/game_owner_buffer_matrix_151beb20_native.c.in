static f32 matrix_value(u32 index) {
    if (index % 4 == 3) return index == 15 ? 1.0f : 0.0f;
    return ((s32)((index + pattern) % 5) - 2) * 0.125f;
}

static void fill_matrix(f32 values[4][4]) {
    for (u32 i = 0; i < 16; i++) values[i / 4][i % 4] = matrix_value(i);
}

__attribute__((noinline,noclone))
void func_150A8050(f32 values[4][4], f32 x, f32 y, f32 z) {
    calls++;
    if (values != actor.matrices[initialPage] || x != 0.0f || y != .75f || z != 0.0f) error = 1;
    fill_matrix(values);
