        if(error)return error;if(answer!=(wantResult?output:0)||callAt!=callCount||childCount!=snapshotCount)return 18;
        n=success?136:16;for(i=0;i<n;i++)if(((u8*)output)[i]!=wantOutput[i])return 19;
        for(i=0;i<80;i++)if(((u8*)&packet)[i]!=wantPacket[i])return 20;
        for(i=0;i<12;i++)if(((u8*)&D_800A5480)[i]!=wantVector[i])return 21;
