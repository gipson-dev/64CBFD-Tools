#include <ultra64.h>
@DECLARATIONS@
typedef struct {u32 target,count,args[18];} NativeCall;
typedef struct {u32 fields[10];u8 image[2][148];NativeCall calls[8];u32 vectors[6];} NativeCase;
extern const NativeCase fixture_rows[];
_Static_assert(sizeof(void*)==4 && sizeof(NativeCase)==1000,"native32 fixture");
static const NativeCase *current;
static u8 output[128];
static u32 calls,integers,reals;
f32 D_800AA28C,D_800AA290,D_800AA294,D_800AA298,D_800AA29C;
static f32 *globals[]={&D_800AA28C,&D_800AA290,&D_800AA294,&D_800AA298,&D_800AA29C};
__attribute__((noreturn)) static void quit(int code){__asm__ volatile(".byte 0xcd,0x80"::"a"(1),"b"(code):"memory");__builtin_unreachable();}
static void failure(u32 code){__asm__ volatile(".byte 0xcd,0x80"::"a"(4),"b"(2),"c"(&code),"d"(4):"memory");quit(3);}
#define check(v) do{if(!(v))failure(__LINE__);}while(0)
static u32 bits(f32 f){union{u32 u;f32 f;}v;v.f=f;return v.u;}
static f32 number(u32 u){union{u32 u;f32 f;}v;v.u=u;return v.f;}
static u32 get32(const u8*p){return(u32)p[0]<<24|(u32)p[1]<<16|(u32)p[2]<<8|p[3];}
static void put32(u8*p,u32 n){p[0]=n>>24;p[1]=n>>16;p[2]=n>>8;p[3]=n;}
static void copy(u8*d,const u8*s,u32 n){for(u32 i=0;i<n;i++)((volatile u8*)d)[i]=((const volatile u8*)s)[i];}
static int same(const u8*a,const u8*b,u32 n){for(u32 i=0;i<n;i++)if(a[i]!=b[i])return 0;return 1;}
static void enter(u32 target,u32 count,const u32*a){
 check(calls<8);const NativeCall*expected=current->calls+calls;check(expected->target==target&&expected->count==count);
 for(u32 i=0;i<count;i++)if(expected->args[i]!=a[i])failure(2000+calls*20+i);
 u32 ordinal=calls++;
 if((target==0x150ADA20||target==0x150ADA68)&&(current->fields[7]&1)){
  D_800AA28C=2.f+(f32)ordinal*.25f;D_800AA290=1.f+(f32)ordinal*.125f;
  D_800AA294=(current->fields[8]==2||current->fields[8]==4)?number(0x80000000):4.f+(f32)ordinal*.5f;
  D_800AA298=.125f+(f32)ordinal*.0625f;D_800AA29C=1.5f+(f32)ordinal*.125f;
 }
}
__attribute__((noinline)) s32 func_150ADA20(void){enter(0x150ADA20,0,(void*)0);check(integers<3);return(s32)current->fields[1+integers++];}
__attribute__((noinline)) f32 func_150ADA68(void){
 enter(0x150ADA68,0,(void*)0);check(reals<3);u32 i=reals++,seed=current->fields[0];
 if(i==1&&current->fields[8]==2)return number(0x80000000);
 return i==0?.125f+(f32)seed*.03125f:i==1?.25f+(f32)seed*.0625f:.75f-(f32)seed*.03125f;
}
__attribute__((noinline)) void func_15143794(s16 heading,s16 pitch,f32 speed,TrailPoint151B0050*direction){
 u32 a[]={(u32)(s32)heading,(u32)(s32)pitch,bits(speed),0x60010};enter(0x15143794,4,a);
 u32 seed=current->fields[0];direction->x=7.25f+(f32)seed;direction->y=-8.5f-(f32)seed;direction->z=9.75f+(f32)seed;
}
__attribute__((noinline)) u8 *func_151DA6F8(void*p,void*d,f32 scale,s16 duration,u8 color,f32 time,s32 request,u8 opaque,f32 first,f32 second,u8 fade,u8 selector,s32 extra,s16 a,s16 b,s32 value,u8 channel,s32 context){
 f32*position=p,*direction=d;for(u32 i=0;i<3;i++){check(bits(position[i])==current->vectors[i]);check(bits(direction[i])==current->vectors[3+i]);}
 u32 args[]={0x60000,0x60010,bits(scale),(u32)(s32)duration,color,bits(time),request,opaque,bits(first),bits(second),fade,selector,extra,(u32)(s32)a,(u32)(s32)b,value,channel,context};enter(0x151DA6F8,18,args);
 for(u32 i=0;i<3;i++){put32(output+4*i,bits(position[i]));put32(output+12+4*i,bits(direction[i]));}
 put32(output+24,bits(scale));put32(output+28,(u32)(s32)duration);put32(output+32,color);put32(output+36,bits(time));put32(output+40,request);put32(output+44,channel);
 if(current->fields[7]&4){position[0]=number(bits(position[0])^0x005A0000);direction[2]=number(bits(direction[2])^0x0000A700);}
 return output;
}
@BODY@
static void setup(const u8*b){copy(output,b,128);b+=128;for(u32 i=0;i<5;i++)*globals[i]=number(get32(b+4*i));calls=integers=reals=0;}
static void snapshot(u8*b){copy(b,output,128);for(u32 i=0;i<5;i++)put32(b+128+4*i,bits(*globals[i]));}
static int run(void){for(u32 i=0;i<@COUNT@;i++){
 current=fixture_rows+i;setup(current->image[0]);const u32*c=current->fields;u32 seed=c[0];
 check(func_151B0050(1,7,1.25f+(f32)seed,-2.5f-(f32)seed,3.75f+(f32)seed,0,0,0,(s16)c[4],(s16)c[5],0,0,0,0,(u8)c[6])==1);
 check(calls==8&&integers==3&&reals==3);u8 actual[148];snapshot(actual);check(same(actual,current->image[1],148));
 }return 0;}
__attribute__((force_align_arg_pointer)) void _start(void){quit(run());}
