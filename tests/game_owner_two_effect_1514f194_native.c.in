}
static int check(void(*fn)(u8*)){
 for(u32 i=0;i<sizeof(cases)/sizeof(cases[0]);i++){
  current=&cases[i];for(u32 j=0;j<96;j++)owner.bytes[j]=(u8)(j*29+0x35);
  copy(initialOwner,owner.bytes,96);reset();model();if(error)return 1;
  copy(expectedOwner,owner.bytes,96);copy(expectedCalls,calls,sizeof(calls));copy(expectedObservations,observations,sizeof(observations));expectedCount=count;expectedGate=D_800BE616;
  copy(owner.bytes,initialOwner,96);reset();fn(owner.bytes);
  if(error||count!=expectedCount||D_800BE616!=expectedGate||!equal(owner.bytes,expectedOwner,96)||!equal(calls,expectedCalls,sizeof(calls))||!equal(observations,expectedObservations,sizeof(observations)))return 1;
 }
 return 0;
}
