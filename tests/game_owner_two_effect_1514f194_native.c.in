/* Independent sequence and field contract; actual pointer identities are compared. */
static void model(void){
 u8*p=owner.bytes;
 func_151D0F60(p,1,255,1);func_151D0F60(p,2,255,1);func_151BB044(p);
 if(!D_800BE616)func_151BC074(p);
