 u32 mutation=current->fields[9];
 if(mutation&1){holder.record.vertices=otherVertices;D_800BE9C0^=1;holder.record.count=1;holder.record.texture=current->fields[3]==54?55:54;}
 if(mutation&4){D_80090B60[current->fields[3]].width=999;D_80090B60[current->fields[3]].height=1001;D_800D2C9C=0x001234AB;}
