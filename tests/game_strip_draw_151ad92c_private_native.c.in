@BODY@
static void loadVertices(Vtx*v,const u8*b){copy((u8*)v,b,2560);for(u32 i=0;i<160;i++){
 for(u32 j=0;j<3;j++)v[i].v.ob[j]=get16(b+i*16+j*2);
 v[i].v.flag=get16(b+i*16+6);v[i].v.tc[0]=get16(b+i*16+8);v[i].v.tc[1]=get16(b+i*16+10);}}
static void saveVertices(u8*b,const Vtx*v){copy(b,(const u8*)v,2560);for(u32 i=0;i<160;i++){
 for(u32 j=0;j<3;j++)put16(b+i*16+j*2,v[i].v.ob[j]);
 put16(b+i*16+6,v[i].v.flag);put16(b+i*16+8,v[i].v.tc[0]);put16(b+i*16+10,v[i].v.tc[1]);}}
static void loadCommands(Gfx*v,const u8*b){for(u32 i=0;i<512;i++){v[i].words.w0=get32(b+i*8);v[i].words.w1=get32(b+i*8+4);}}
static void saveCommands(u8*b,const Gfx*v){for(u32 i=0;i<512;i++){u32 w0=v[i].words.w0,w1=v[i].words.w1;
 if(w0==0x01008010)w1=vertexAddress((void*)w1);put32(b+i*8,w0);put32(b+i*8+4,w1);}}
static void setup(const u8*b){
 copy((u8*)&holder,b,128);holder.record.points=points;holder.record.texture=get16(b+64);holder.record.vertices=vertices;b+=128;
 copy((u8*)points,b,480);for(u32 i=0;i<20;i++)for(u32 j=0;j<3;j++)points[i].position[j]=number(get32(b+i*24+j*4));b+=480;
 loadVertices(vertices,b);b+=2560;loadVertices(otherVertices,b);b+=2560;
 loadCommands(commands,b);b+=4096;loadCommands(otherCommands,b);b+=4096;
 copy((u8*)D_80090B60,b,672);for(u32 i=0;i<56;i++){D_80090B60[i].width=get16(b+i*12+6);D_80090B60[i].height=get16(b+i*12+8);}b+=672;
 D_800BE9C0=get32(b);D_800D2C9C=get32(b+4);ordinal=0;
}
static void snapshot(u8*b){
 copy(b,(const u8*)&holder,128);check(holder.record.points==points);put32(b+56,0x50000);put16(b+64,holder.record.texture);put32(b+72,vertexAddress(holder.record.vertices));b+=128;
 copy(b,(const u8*)points,480);for(u32 i=0;i<20;i++)for(u32 j=0;j<3;j++)put32(b+i*24+j*4,bits(points[i].position[j]));b+=480;
 saveVertices(b,vertices);b+=2560;saveVertices(b,otherVertices);b+=2560;
 saveCommands(b,commands);b+=4096;saveCommands(b,otherCommands);b+=4096;
 copy(b,(u8*)D_80090B60,672);for(u32 i=0;i<56;i++){put16(b+i*12+6,D_80090B60[i].width);put16(b+i*12+8,D_80090B60[i].height);}b+=672;
 put32(b,D_800BE9C0);put32(b+4,D_800D2C9C);
}
static Gfx*(*volatile invoke)(Gfx*,u8*,s32)=func_151AD92C;
static u8 observed[14600];
static int run(void){for(u32 i=0;i<@COUNT@;i++){
 current=fixture_rows+i;setup(current->image[0]);Gfx*answer=invoke(commands,(u8*)&holder.record,current->fields[8]);
 check(ordinal==1&&gfxAddress(answer)==current->answer);snapshot(observed);check(same(observed,current->image[1],14600));
