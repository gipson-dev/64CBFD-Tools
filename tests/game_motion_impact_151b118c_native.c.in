@BODY@
extern const u8 fixture_rows[],fixture_end[];
static const u8 *file;
static void exact_read(void *dest,u32 n){if(file+n>fixture_end)fail("short fixture");memcpy(dest,file,n);file+=n;}
static u32 get32(void){u32 n;exact_read(&n,4);return n;}
static void mapping(u32 a,u32 n){u32 args[]={a,n,3,0x100022u,0xFFFFFFFFu,0},answer;__asm__ volatile("int $0x80":"=a"(answer):"a"(90),"b"(args):"memory");if(answer!=a)fail("mapping");}
static u8 expected[4][512],initial[512];
static int run(void){
 mapping(A,4096);mapping(MARK,4096);mapping(0x800A0000u,0x20000);file=fixture_rows;
 if(sizeof(void*)!=4||sizeof(HeightResult71820)!=36)fail("native layout");
 u32 cases=get32(),segments=get32();if(segments!=4)fail("segments");
 for(u32 k=0;k<cases;k++){
  seed=get32();hit=get32();parity=get32();mutation=get32();u32 wanted_trace=get32(),wanted_answer=get32(),addresses[4],lengths[4];
  for(u32 s=0;s<segments;s++){u32 a=addresses[s]=get32(),n=lengths[s]=get32();if(n>512)fail("segment length");exact_read(initial,n);exact_read(expected[s],n);memcpy(ptr(a),initial,n);}
  trace=2166136261u;ordinal=0;retained_probe=NULL;
  s32 answer=func_151B118C(ptr(A));if((u32)answer!=wanted_answer)fail("answer");if(trace!=wanted_trace)fail("trace");
  for(u32 s=0;s<segments;s++)for(u32 i=0;i<lengths[s];i++)if(ptr(addresses[s])[i]!=expected[s][i]){hex(k);hex(addresses[s]+i);hex(ptr(addresses[s])[i]);hex(expected[s][i]);fail("memory");}
 }
 if(file!=fixture_end)fail("fixture tail");return 0;
}
__attribute__((force_align_arg_pointer))void _start(void){quit(run());}
